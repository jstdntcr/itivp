@base = http://localhost:8080

############################################################
# Аутентификация (ЛР№3)
############################################################

### Регистрация -> 201
POST {{base}}/auth/register
Content-Type: application/json

{
  "email": "tutor@example.com",
  "password": "secret123"
}

### Вход -> 200 (сохраняем токены в переменные REST Client)
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "tutor@example.com",
  "password": "secret123"
}

### Текущий пользователь (защищённый) -> 200
GET {{base}}/profile
Authorization: Bearer {{login.response.body.accessToken}}

### Профиль без токена -> 401
GET {{base}}/profile

### Обновление пары токенов -> 200
POST {{base}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.refreshToken}}"
}

############################################################
# Репетиторы (чтение — публичное, изменение — по токену)
############################################################

### Список всех репетиторов -> 200
GET {{base}}/tutors

### Один репетитор по id -> 200
GET {{base}}/tutors/1

### Несуществующий репетитор -> 404
GET {{base}}/tutors/999

### Создание репетитора без токена -> 401
POST {{base}}/tutors
Content-Type: application/json

{
  "name": "Мария Ковалёва",
  "subject": "Физика"
}

### Создание репетитора с токеном -> 201
POST {{base}}/tutors
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
  "name": "Мария Ковалёва",
  "subject": "Физика",
  "bio": "Механика и электродинамика для школьников.",
  "hourlyRate": 45
}

### Полное обновление (с токеном) -> 200
PUT {{base}}/tutors/1
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
  "name": "Анна Смирнова",
  "subject": "Высшая математика",
  "bio": "Подготовка студентов к сессии."
}

### Удаление (с токеном) -> 200
DELETE {{base}}/tutors/2
Authorization: Bearer {{login.response.body.accessToken}}
